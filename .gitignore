# ignore secrets, state, and machine-local notes — the repo is public

# OpenTofu / Terraform
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
*.plan
crash.log
crash.*.log
*.tfvars
*.tfvars.json
!*.tfvars.example
.terraformrc
terraform.rc

# Secrets / encryption
*.agekey
age.key
*.sops.yaml.bak
secrets*.yaml
.env
.env.*
!.env.example
*.pem
*.key
!**/*.pub
# SOPS ciphertext is safe to commit — never let a secret-looking name hide it
!*.sops.yaml
!*.sops.yml

# Kubernetes
kubeconfig*
*.kubeconfig
talosconfig*
talos/out/
*.secret.yaml
*.secret.yml

# Machine-local / private notes (never publish)
docs/private/

# Editor / OS
.DS_Store
.idea/
.vscode/
*.swp
