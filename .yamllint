---
# yamllint configuration
extends: default

# Never lint generated or local-only files (e.g. talos/out/ machine configs, .terraform/).
ignore-from-file: .gitignore

rules:
  line-length: disable
  document-start: disable
  comments-indentation: disable
  truthy:
    allowed-values: ['true', 'false']
    check-keys: false
