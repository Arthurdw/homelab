# Copy to `terraform.tfvars` (gitignored) and fill in. NEVER commit real values.

# --- Proxmox API / SSH ---
# https://<proxmox-host>:8006/
proxmox_endpoint = "https://CHANGE-ME:8006/"

# true only for a self-signed cert on a trusted management network
proxmox_insecure = true

proxmox_ssh_username = "root"

# --- Proxmox host ---
# PVE node name (normally the host hostname). TODO(GATE 4): confirm at cutover.
proxmox_node_name = "poseidon"

# --- Networking (production values; lab overrides in comments) ---
# Host bridge for the node NICs: VLAN-aware, set up by docs/runbooks/host-network-bootstrap.md.
vm_bridge = "vmbr0"

# K8s VLAN 20 (docs/decisions.md §2.1). Lab: set to null on a flat bridge.
k8s_vlan_id      = 20
k8s_gateway      = "10.20.0.1"
k8s_prefix_length = 24
talos_cp_ipv4    = "10.20.0.11"   # lab: 10.99.100.11
talos_wk_ipv4    = "10.20.0.12"   # lab: 10.99.100.12
talos_wk2_ipv4   = "10.20.0.13"   # lab: 10.99.100.13

# --- Talos VMIDs ---
# TODO(GATE 4): confirm at cutover (the temporary live VM uses 100).
talos_cp_vmid = 110
talos_wk_vmid = 111
talos_wk2_vmid = 112

# Optional fixed MACs, keyed by node name. TODO(GATE 4): assign with UniFi reservations.
# talos_macs = {
#   talos-cp-1 = "BC:24:11:00:00:11"
#   talos-wk-1 = "BC:24:11:00:00:12"
#   talos-wk-2 = "BC:24:11:00:00:13"
# }

# --- Storage ---
talos_disk_datastore_id  = "local-lvm"   # host SSD; never the NAS (docs/decisions.md §3.2)
talos_image_datastore_id = "local"       # needs 'iso' content enabled

# --- Talos image (Image Factory) ---
# talos/schematic.yaml: siderolabs/kata-containers, siderolabs/qemu-guest-agent and the NVIDIA pair
# (nonfree-kmod-nvidia-production, nvidia-container-toolkit-production); same id as TALOS_SCHEMATIC in
# talos/inputs.env.
talos_image_schematic_id = "a31c606a63e512b77145a19a7441828049b1567936ab8335f24bf8d28e831736"
talos_image_platform     = "nocloud"   # Proxmox uses the NoCloud datasource
talos_image_compression  = "zst"

# --- Talos node behaviour ---
# The default schematic includes siderolabs/qemu-guest-agent (its Talos service waits for the agent channel), so
# keep this true. Set false only with an image that lacks the extension (Proxmox would wait for a missing agent).
talos_qemu_guest_agent_enabled = true

# Kata Containers runs each pod in a microVM and needs nested virtualization: CPU type `host` here AND nested KVM
# enabled on the PVE host (kvm_intel/kvm_amd nested=1). Owner-gated, see docs/decisions.md §3.5.
# talos_cpu_type = "host"

# "talosctl" keeps the ownership boundary (docs/architecture.md §7).
talos_machine_config_delivery = "talosctl"

# --- Host capacity check ---
proxmox_host_memory_mb        = 47104   # 46 GiB usable (docs/hardware.md)
proxmox_host_memory_reserve_mb = 8192

# --- Sizing and power state (defaults are the production topology, docs/decisions.md §3.1) ---
# Only the L1 fixture (scripts/lab/pve-fixture-plan.sh) overrides these, to fit a 4 GiB nested PVE:
# talos_cp_memory_mb    = 4096
# talos_cp_disk_gb      = 20
# talos_wk_cpu_cores    = 3
# talos_wk_memory_mb    = 16384
# talos_wk_disk_gb      = 80
# talos_wk_data_disk_gb = 100    # null = no data disk
# talos_wk2_cpu_cores    = 3
# talos_wk2_memory_mb    = 12288
# talos_wk2_disk_gb      = 40
# talos_wk2_data_disk_gb = 100   # null = no data disk
# talos_vm_started      = true
# talos_vm_on_boot      = true

# 10 GbE storage link to the NAS (storage-link.tf; defaults shown). nic2 needs `mtu 9000` set by hand first.
# storage_link_bridge  = "vmbr1"
# storage_link_port    = "nic2"
# storage_link_address = "10.99.0.1/29"
# storage_link_mtu     = 9000
# talos_storage_link_nic = true   # net1 on vmbr1 for each Talos VM; false where there is no link

# The Tesla P4 as a cluster PCI resource mapping, passed to one Talos VM (gpu.tf; defaults shown). Check the
# address and IOMMU group on the host first (docs/hardware.md). null = no mapping, e.g. a host without the card.
# gpu_passthrough = {
#   mapping_name = "tesla-p4"
#   pci_path     = "0000:01:00.0"
#   device_id    = "10de:1bb3"
#   iommu_group  = 2
#   vm           = "talos-wk-1"   # null keeps the mapping but gives the card to no Talos VM
# }
