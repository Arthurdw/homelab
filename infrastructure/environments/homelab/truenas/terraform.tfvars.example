# Copy to `terraform.tfvars` (gitignored) and fill in, or export TF_VAR_* instead.
# NEVER commit real values.

# wss://<truenas-host>/api/current   (JSON-RPC; TrueNAS >= 25.04 only)
truenas_endpoint = "wss://CHANGE-ME/api/current"

# Prefer: export TF_VAR_truenas_api_key='...'   (keep the key out of files entirely)
truenas_api_key = "REPLACE-ME"

truenas_insecure = true

# Kubernetes NFS export (defaults shown; see variables.tf)
# k8s_dataset_name         = "main/k8s"
# k8s_nfs_allowed_networks = ["10.99.0.0/29"]   # the storage link; never 0.0.0.0/0
# k8s_nfs_maproot_user     = "root"
# k8s_nfs_maproot_group    = "root"

# Household backups (docs/runbooks/household-backups.md). The Kopia and Seafile NFS exports reuse
# k8s_nfs_allowed_networks and the maproot variables above.
# TODO(owner): required, no default. 2x the Mac's disk is the usual rule (a 512 GB Mac -> 1024).
timemachine_jolien_quota_gib = 1024
# timemachine_jolien_share_name = "timemachine-jolien"

# jolien's Tier 1 share and photo archive (tiers.tf, decisions.md §5.17). TODO(owner): required, no default.
# The size of her drives plus room to grow and for 30 days of snapshots (6-8 TB of drives -> 10240).
tier1_jolien_quota_gib = 10240
# tier1_jolien_share_name = "jolien"

# Household accounts (users.tf). jolien and dunia are created by OpenTofu; arthur already exists and is
# imported, never changed. The two passwords have no default and do NOT go in this file: they are
# ephemeral variables, read from the shell on the apply that creates the accounts:
#   read -rs TF_VAR_user_jolien_password && export TF_VAR_user_jolien_password
#   read -rs TF_VAR_user_dunia_password && export TF_VAR_user_dunia_password

# 10 GbE storage link to poseidon (storage-link.tf). TODO(GATE 4): the NAS's 10 GbE port name, from the
# TrueNAS UI under Network. Required, no default.
storage_link_interface = "CHANGE-ME"
# storage_link_name          = "bond1"
# storage_link_address       = "10.99.0.2"
# storage_link_prefix_length = 29
# storage_link_mtu           = 9000
