# Copy to /etc/homelab/alert.env (mode 0600, OUTSIDE this repo) and edit. Placeholders only.
# NEVER commit real values. Read by homelab-backup-alert@.service (backup-alert.sh).

# smtps://host:465 for implicit TLS, or smtp://host:587 for STARTTLS (TLS is always required).
ALERT_SMTP_URL="smtps://smtp.example.invalid:465"
ALERT_MAIL_FROM="homelab-backup@example.invalid"
# Space-separated recipients.
ALERT_MAIL_TO="owner@example.invalid"

# The SMTP login is NOT set here. It lives in a netrc file curl reads itself, so the password
# never appears in argv or the environment. Create it as root, mode 0600:
#   machine smtp.example.invalid login CHANGE-ME password CHANGE-ME
ALERT_NETRC_FILE="/etc/homelab/alert.netrc"

# ALERT_JOURNAL_LINES="50"
# ALERT_SUBJECT_PREFIX="[homelab]"
