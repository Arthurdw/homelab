# Copy to a protected location OUTSIDE this repo (e.g. /etc/homelab/backup.env, mode 0600)
# and edit. NEVER commit real values. See docs/backup-policy.md.

# --- restic repository (destination, offsite) ---
# sftp:|rest:|rclone:|s3:... — pick what the offsite host supports.
RESTIC_REPOSITORY="sftp:backup@CHANGE-ME:/srv/restic/homelab"

# Password file for the repository (separate from the key files below).
RESTIC_PASSWORD_FILE="/etc/homelab/restic-password"

# --- what to back up ---
# Space-separated absolute paths. Tier-1/Tier-2 only — never bulk media (Tier 3).
# Datasets per docs/decisions.md section 4.1.
BACKUP_PATHS="/mnt/main/tier1/arthur /mnt/main/tier1/jolien /mnt/main/tier1/dunia"
RESTIC_TAG="tier1"
# RESTIC_EXCLUDE_FILE="/etc/homelab/restic-excludes.txt"

# --- retention ---
KEEP_DAILY="7"
KEEP_WEEKLY="4"
KEEP_MONTHLY="12"
