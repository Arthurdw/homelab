[Unit]
Description=Verify the offsite backup repository (restic check + sample restore)
Documentation=file:docs/backup-policy.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
EnvironmentFile=/etc/homelab/backup.env
# Higher subset on the weekly verify; see RESTIC_READ_DATA_SUBSET.
Environment=RESTIC_READ_DATA_SUBSET=10%
Environment=RESTIC_RESTORE_DIR=/var/tmp/restic-restore-test
ExecStart=/usr/local/bin/homelab-restic-check
Nice=10
IOSchedulingClass=idle
OnFailure=homelab-backup-alert@%n.service

[Install]
WantedBy=multi-user.target
