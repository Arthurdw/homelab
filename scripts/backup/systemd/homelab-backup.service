[Unit]
Description=Restic backup
After=network-online.target
Wants=network-online.target
OnFailure=homelab-backup-alert@%n.service

[Service]
Type=oneshot
# EnvironmentFile holds RESTIC_* and BACKUP_PATHS. Keep it mode 0600 outside the repo.
EnvironmentFile=/etc/homelab/backup.env
# systemd gives the service no $HOME, so restic would run uncached; keep its cache here.
CacheDirectory=homelab-restic
Environment=RESTIC_CACHE_DIR=/var/cache/homelab-restic
ExecStart=/usr/local/bin/homelab-restic-backup
Nice=10
IOSchedulingClass=idle
