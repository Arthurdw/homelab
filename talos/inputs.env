# Talos cluster inputs — the single place for every value that is not yet decided.
#
# Sourced by scripts/talos/gen-configs.sh and scripts/talos/validate.sh. It contains NO secrets:
# the generated machine configs embed the cluster PKI/secrets and are written to a gitignored
# directory (TALOS_OUT_DIR) instead. See talos/README.md.
#
# Every value below marked TODO(GATE 0) is a placeholder that the owner must confirm or replace;
# the question list is docs/PROJECT-PLAN.md §10 and the topology hypothesis is docs/architecture.md §3.
#
# Each value is written as ${VAR:-default} so that an environment variable already exported on the
# command line takes precedence (handy for tests and dry runs). Edit the defaults here, not inline in
# commands.

# Logical cluster name (used by talosctl and in the generated configs). Not sensitive.
CLUSTER_NAME="${CLUSTER_NAME:-homelab}"

# Kubernetes API endpoint that nodes and clients talk to (host:port or URL).
# TODO(GATE 0): the API endpoint / VIP / load-balancer address is undecided (architecture.md §3).
# The default below uses the RFC 5737 TEST-NET-1 documentation range: it is NOT a real address,
# nothing will ever answer on it, and it MUST be replaced before any config is used.
CLUSTER_ENDPOINT="${CLUSTER_ENDPOINT:-https://192.0.2.1:6443}"

# Disk the OS is installed to inside each node VM.
# TODO(GATE 0): confirm the Proxmox VM disk bus once the template exists (Phase 4) —
# virtio-blk presents /dev/vda, virtio-scsi presents /dev/sda.
INSTALL_DISK="${INSTALL_DISK:-/dev/sda}"

# Installer image written into machine.install.image.
# TODO(GATE 0): choose the vanilla installer (below, derived from versions.yaml) or an image-factory
# schematic. A schematic is only needed once system extensions (e.g. GPU/iSCSI/NVMe drivers) are
# chosen — none are decided yet. Leave empty to derive `ghcr.io/siderolabs/installer:<talos>`.
INSTALL_IMAGE="${INSTALL_IMAGE:-}"

# Extra Subject Alternative Names for the API server certificate (comma-separated, may be empty).
# TODO(GATE 0): add the decided DNS name / VIP for the API endpoint when it differs from
# CLUSTER_ENDPOINT.
ADDITIONAL_SANS="${ADDITIONAL_SANS:-}"

# Where generated machine configs + talosconfig are written. GITIGNORED (see .gitignore) because the
# files embed the cluster PKI and secrets. Path is relative to the repository root unless absolute.
TALOS_OUT_DIR="${TALOS_OUT_DIR:-talos/out}"
