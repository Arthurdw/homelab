# Talos cluster inputs — the single place for every value that is not yet decided.
#
# Sourced by scripts/talos/gen-configs.sh and scripts/talos/validate.sh. It contains NO secrets:
# the generated machine configs embed the cluster PKI/secrets and are written to a gitignored
# directory (TALOS_OUT_DIR) instead. See talos/README.md.
#
# Values marked TODO(GATE 4) can only be confirmed at cutover, like the matching markers in
# infrastructure/. Each is written as ${VAR:-default} so an exported environment variable wins.

# Logical cluster name (used by talosctl and in the generated configs). Not sensitive.
CLUSTER_NAME="${CLUSTER_NAME:-homelab}"

# Kubernetes API endpoint that nodes and clients talk to (host:port or URL).
# talos-cp-1's address (docs/decisions.md §2.1; `talos_nodes` in infrastructure/environments/homelab/proxmox).
# One control plane and no VIP (§3.1), so the endpoint is the node itself. A VIP later means new certs.
CLUSTER_ENDPOINT="${CLUSTER_ENDPOINT:-https://10.20.0.11:6443}"

# Disk the OS is installed to inside each node VM.
# The talos-vm module defaults to a SCSI boot disk (`scsi0`), which Talos sees as /dev/sda.
# A virtio-blk disk (`virtio0`) would be /dev/vda — keep the two in step.
INSTALL_DISK="${INSTALL_DISK:-/dev/sda}"

# Installer image written into machine.install.image.
# Empty derives factory.talos.dev/<TALOS_PLATFORM>-installer/<TALOS_SCHEMATIC>:<talos pin>. The platform
# must match the boot image (Proxmox: nocloud, infrastructure/environments/homelab/proxmox). The schematic is
# talos/schematic.yaml (kata-containers, qemu-guest-agent), shared with the lab; its id is the sha256 Image Factory
# returns for it. GPU_WORKER_NODE instead gets talos/schematic-gpu.yaml (the same plus the NVIDIA pair) through
# GPU_TALOS_SCHEMATIC / GPU_INSTALL_IMAGE; that id equals talos_image_schematic_id in the Proxmox environment.
INSTALL_IMAGE="${INSTALL_IMAGE:-}"
TALOS_PLATFORM="${TALOS_PLATFORM:-nocloud}"
TALOS_SCHEMATIC="${TALOS_SCHEMATIC:-2ed2e4794ba4c5fff3e18307516a15accd3c0d992408c0c9522d2d457a79429f}"
GPU_INSTALL_IMAGE="${GPU_INSTALL_IMAGE:-}"
GPU_TALOS_SCHEMATIC="${GPU_TALOS_SCHEMATIC:-08d87116314dbc848da5843a26140ad62f1a97d0d27a5358f6380337e865b739}"

# Extra Subject Alternative Names for the API server certificate (comma-separated, may be empty).
# TODO(GATE 4): add the API DNS name if one is created alongside CLUSTER_ENDPOINT.
ADDITIONAL_SANS="${ADDITIONAL_SANS:-}"

# Where generated machine configs + talosconfig are written. GITIGNORED (see .gitignore) because the
# files embed the cluster PKI and secrets. Path is relative to the repository root unless absolute.
TALOS_OUT_DIR="${TALOS_OUT_DIR:-talos/out}"
