# Talos cluster inputs for the LIBVIRT LAB (scripts/lab/virt/*).
#
# Deliberately separate from talos/inputs.env so the production inputs stay untouched. Sourced by
# scripts/talos/gen-configs.sh when TALOS_INPUTS points here; the generated configs go to the
# gitignored talos/out/lab (talos/out/ is in .gitignore).
#
# No secrets are stored here: the generated machine configs embed the cluster PKI/secrets and are
# never committed. Lab addressing is docs/decisions.md §2.4.

# Logical cluster name used by talosctl and in the generated configs.
CLUSTER_NAME="${CLUSTER_NAME:-homelab-lab}"

# The single control-plane node is the API endpoint — the lab has no VIP or load balancer
# (guests.tsv: lab-talos-cp is 10.99.100.11).
CLUSTER_ENDPOINT="${CLUSTER_ENDPOINT:-https://10.99.100.11:6443}"

# The guest disk is virtio-blk (guests.tsv and lib.sh both use bus='virtio'), which Talos sees as
# /dev/vda — NOT the /dev/sda of the production virtio-scsi VMs in talos/inputs.env.
INSTALL_DISK="${INSTALL_DISK:-/dev/vda}"

# Empty => factory.talos.dev/metal-installer/<schematic>:<talos pin>. The guests boot the metal
# ISO, so the installer is the metal one (production uses nocloud).
INSTALL_IMAGE="${INSTALL_IMAGE:-}"
TALOS_PLATFORM="${TALOS_PLATFORM:-metal}"

# Extra API-server SANs (comma-separated). Required in the lab: without the node IPs, talosctl
# against 10.99.100.11 fails TLS verification ("certificate is valid for 127.0.0.1").
ADDITIONAL_SANS="${ADDITIONAL_SANS:-10.99.100.11,10.99.100.12}"

# GITIGNORED output directory, relative to the repo root.
TALOS_OUT_DIR="${TALOS_OUT_DIR:-talos/out/lab}"

# The lab worker has a single 40 GiB disk (guests.tsv) and no data disk, so the production
# UserVolumeConfig (`!system_disk`, 90GiB; talos/patches/worker.yaml) could never be provisioned.
# Empty = do not apply it. Consequence: no /var/mnt/local-path-provisioner exists in the lab, so
# the lab's local-path StorageClass must not rely on it (point nodePathMap elsewhere or skip it).
WORKER_PATCH="${WORKER_PATCH-}"

# The lab guests have one NIC and no storage link, so the production storage-link NIC and node-IP
# pinning patches (talos/patches/network-*.yaml, docs/decisions.md §2.2) do not apply. Empty = skip.
CONTROLPLANE_NETWORK_PATCH="${CONTROLPLANE_NETWORK_PATCH-}"
WORKER_NETWORK_PATCH="${WORKER_NETWORK_PATCH-}"

# No GPU in the lab, so the NVIDIA modules (talos/patches/gpu-worker.yaml) would fail to load. Empty = skip.
GPU_WORKER_PATCH="${GPU_WORKER_PATCH-}"

# One worker, so no per-node worker configs (talos/patches/node-*.yaml carry production storage-link
# addresses): gen-configs.sh writes a single worker.yaml, as before. Empty = skip.
WORKER_NODES="${WORKER_NODES-}"
